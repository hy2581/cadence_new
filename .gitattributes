# Normalize line endings to LF on commit; OS-native on checkout.
# Prevents CRLF/LF churn when the repo is shared across Windows and Linux.
* text=auto eol=lf

# Force LF for shell scripts (must remain LF even on Windows checkout)
*.sh        text eol=lf
*.py        text eol=lf

# Treat HDL / hex / verification source as text
*.sv        text eol=lf
*.svh       text eol=lf
*.v         text eol=lf
*.vh        text eol=lf
*.f         text eol=lf
*.tcl       text eol=lf
*.sdc       text eol=lf
*.hex       text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.md        text eol=lf

# Binary files - never normalize
*.docx      binary
*.pdf       binary
*.png       binary
*.jpg       binary
*.zip       binary
